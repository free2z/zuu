    "circom2": "0.2.22",
    "circomlib": "2.0.5",
    "clsx": "^2.1.1",
    "embla-carousel-svelte": "^8.6.0",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-svelte": "^3.23.1",
    "mode-watcher": "^1.1.0",
    "orval": "^8.42.0",
    "parse5": "8.0.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "snarkjs": "0.7.6",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.9.0",
    "svelte-sonner": "^1.2.1",
