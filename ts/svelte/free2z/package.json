    "mermaid": "^10.9.8",
    "qrcode": "^1.5.4",
    "sharp": "0.35.5"
  },
  "overrides": {
    "@cloudflare/realtimekit": {
      "uuid": "^11.1.1"
    },
    "mermaid": {
      "katex": "$katex"
    },
    "@scalar/json-magic": {
      "undici": "7.30.1"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    },
    "runed": "0.38.0",
    "snarkjs": {
      "underscore": "1.13.8"
    }
  }
