{
  "name": "free2z-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "preflight": "node scripts/preflight.mjs",
    "pretest": "node scripts/preflight.mjs",
    "test": "node --test tests/*.test.mjs",
    "pretest:browser": "node scripts/preflight.mjs",
    "test:browser": "playwright test",
    "lint": "prettier --check . && eslint .",
    "lint:compat": "eslint src",
    "format": "prettier --write .",
    "generate:api": "svelte-kit sync && orval",
    "prebuild": "node scripts/build-recorder.mjs static && node scripts/campaign-proof-assets.mjs",
    "campaign:proof-assets": "node scripts/campaign-proof-assets.mjs",
    "campaign:proof-generate": "node scripts/generate-campaign-proof.mjs"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.56.0",
    "@playwright/test": "^1.64.0",
