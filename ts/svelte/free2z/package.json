  "dependencies": {
    "@cloudflare/realtimekit": "2.0.3",
    "@cloudflare/realtimekit-recording-sdk": "0.0.4",
    "@cloudflare/realtimekit-ui": "2.0.3",
    "@resvg/resvg-js": "^2.6.2",
    "@stripe/stripe-js": "^9.17.0",
    "@sveltekit-i18n/base": "^1.3.8",
    "@sveltekit-i18n/parser-default": "^1.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/marked": "^5.0.2",
    "date-fns": "^4.4.0",
