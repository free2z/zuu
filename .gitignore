bazel-*
.DS_Store
node_modules
private/
.vscode/
# Isolated agent worktrees created by the Claude Code harness (see AGENTS.md).
# Only the worktrees dir is ignored: the rest of .claude/ (settings.json,
# agents/, commands/) stays trackable.
.claude/worktrees/
*.log
target/
# Checksum-verified cargo-deny binary fetched by scripts/check-rust-deny.sh.
.cargo-deny/
*.pyc
__pycache__
wallet/zuuli/dist/
ts/svelte/free2z/.svelte-kit/
ts/svelte/free2z/build/



# Application route; only unrelated private directories are excluded.
!ts/svelte/free2z/src/routes/\[username\]/private/

# Browser-test output is not application source or a live-reload input.
ts/svelte/free2z/playwright-report/
ts/svelte/free2z/test-results/
ts/svelte/free2z/playwright-report-local-*/
ts/svelte/free2z/test-results-local-*/
# Generated recorder bundles.
ts/svelte/free2z/static/_app/
ts/svelte/free2z/static/tools/
# Campaign demo proving assets are rebuilt from pinned public inputs and
# hash-checked by scripts/campaign-proof-assets.mjs; only the manifest and the
# verifier key are source.
ts/svelte/free2z/static/projects/campaign-demo-proof/*
!ts/svelte/free2z/static/projects/campaign-demo-proof/manifest.json
!ts/svelte/free2z/static/projects/campaign-demo-proof/verification-key.json

# Local Python environments contain installed dependencies, not source.
/.venv*/

# Generated SvelteKit state belongs to the test process.
ts/svelte/free2z/.svelte-kit-test-*/

# Recorder publication stages beside, never inside, the served asset tree.
ts/svelte/free2z/.recorder-*/
