      }
    },
    {
      "name": "developer_floor_fractional",
      "note": "d = 0.1157409375 2Z floors to 115 milli; provider ceil(1234.57) = 1235 milli.",
      "input": {
        "cost_nusd": 12345700,
        "platform_margin_bps": 2500,
        "dev_markup_bps": 750,
        "min_charge_2z": 1
      },
      "expected": {
        "total_milli": 2000,
