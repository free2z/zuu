        "platform_milli": 12346482
      }
    },
    {
      "name": "just_over_a_boundary",
      "note": "$0.020000001 at 0%: one nano-USD over 2 2Z rounds to 3.",
      "input": {
        "cost_nusd": 20000001,
        "platform_margin_bps": 0,
        "dev_markup_bps": 0,
        "min_charge_2z": 1
      },
      "expected": {
        "total_milli": 3000,
