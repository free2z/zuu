      }
    },
    {
      "name": "large_cost_100pct_margin",
      "note": "$123.456789 at 100% margin, 25% markup.",
      "input": {
        "cost_nusd": 123456789000,
        "platform_margin_bps": 10000,
        "dev_markup_bps": 2500,
