  "components": {
    "schemas": {
      "Register": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "invitation",
          "queue",
          "manage",
          "send",
          "provider",
          "token",
          "expires"
        ],
        "properties": {
          "invitation": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "queue": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "manage": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "send": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "provider": {
            "type": "string",
            "enum": [
              "apns",
              "fcm"
            ]
          },
          "token": {
            "type": "string",
            "minLength": 20,
            "maxLength": 4096
          },
          "expires": {
            "type": "integer",
            "minimum": 1,
            "maximum": 18446744073709551615
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "provider": {
                  "const": "apns"
                }
              }
            },
            "then": {
              "properties": {
                "token": {
                  "pattern": "^(?:[0-9a-f]{2}){16,100}$"
                }
              }
            },
            "else": {
              "properties": {
                "token": {
                  "pattern": "^[A-Za-z0-9_:.-]{20,4096}$"
                }
              }
            }
          }
        ]
      },
      "Rotate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "queue",
          "manage",
          "generation",
          "token"
        ],
        "properties": {
          "queue": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "manage": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 18446744073709551615
          },
          "token": {
            "type": "string",
            "minLength": 20,
            "maxLength": 4096
          }
        }
      },
      "Revoke": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "queue",
          "manage"
        ],
        "properties": {
          "queue": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "manage": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        }
      },
      "Wake": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "queue",
          "send",
          "sequence"
        ],
        "properties": {
          "queue": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "send": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 18446744073709551615
          }
        }
      }
    }
  }
