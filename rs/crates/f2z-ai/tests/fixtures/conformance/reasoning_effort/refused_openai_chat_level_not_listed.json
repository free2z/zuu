{
  "name": "refused_openai_chat_level_not_listed",
  "feature": "reasoning_effort",
  "source": "provider::check_reasoning_effort: a level outside the signed controls.effort_levels is refused (GPT-5.1+ dropped minimal, developers.openai.com model pages).",
  "api_style": "openai_chat",
  "provider": "openai",
  "catalog_model": {
    "capabilities": {
      "reasoning": true,
      "reasoning_effort": true
    },
    "controls": {
      "effort_levels": [
        "low",
        "medium",
        "high"
      ]
    }
  },
  "request": {
    "model": "m-openai-chat",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Think, then answer."
          }
        ]
      }
    ],
    "reasoning_effort": "minimal"
  },
  "expect": {
    "refusal": {
      "status": 400,
      "code": "invalid_request",
      "details": {
        "reason": "reasoning_effort_unsupported",
        "field": "reasoning_effort",
        "effort_levels": [
          "low",
          "medium",
          "high"
        ]
      }
    },
    "encodings": {}
  }
}
