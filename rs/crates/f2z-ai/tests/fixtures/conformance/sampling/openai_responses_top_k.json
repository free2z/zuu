{
  "name": "openai_responses_top_k",
  "feature": "sampling",
  "source": "Synthetic documented-shape sampling fixture. Official references: https://developers.openai.com/api/reference/resources/chat ; https://developers.openai.com/api/reference/resources/responses ; https://platform.claude.com/docs/en/api/messages ; https://docs.x.ai/developers/model-capabilities/text/generate-text . No live provider data.",
  "api_style": "openai_responses",
  "provider": "openai",
  "catalog_model": {
    "capabilities": {
      "seed": true,
      "logprobs": true,
      "penalties": true,
      "top_k": true
    }
  },
  "request": {
    "model": "m-openai-responses",
    "messages": [
      {
        "role": "system",
        "content": [
          {
            "type": "text",
            "text": "Be brief."
          }
        ]
      },
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Half of a pie?"
          }
        ]
      }
    ],
    "max_output_tokens": 256,
    "top_k": 20
  },
  "expect": {
    "refusal": {
      "status": 400,
      "code": "invalid_request",
      "details": {
        "field": "top_k",
        "reason": "unsupported"
      }
    },
    "encodings": {
      "chat_completions": {
        "refusal": {
          "status": 400,
          "code": "invalid_request",
          "details": {
            "field": "/top_k",
            "reason": "unsupported"
          },
          "body": {
            "error": {
              "code": "invalid_request",
              "message": "sampling control cannot be honoured",
              "details": {
                "field": "/top_k",
                "reason": "unsupported"
              },
              "type": "invalid_request_error",
              "param": "/top_k"
            }
          }
        }
      }
    }
  }
}
