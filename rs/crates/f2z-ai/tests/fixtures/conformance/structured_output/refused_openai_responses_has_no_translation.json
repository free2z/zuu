{
  "name": "refused_openai_responses_has_no_translation",
  "feature": "structured_output",
  "source": "metered.rs unsupported_structured_output_is_refused_before_hold_or_provider_io: the Responses adapter has no response_format translation, so even a DECLARED model refuses rather than answer unconstrained.",
  "api_style": "openai_responses",
  "provider": "openai",
  "catalog_model": {
    "capabilities": {
      "structured_output": true
    }
  },
  "request": {
    "model": "m-openai-responses",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "JSON please."
          }
        ]
      }
    ],
    "response_format": {
      "type": "json_object"
    }
  },
  "expect": {
    "refusal": {
      "status": 400,
      "code": "invalid_request",
      "details": {
        "reason": "response_format_unsupported",
        "field": "response_format"
      }
    },
    "encodings": {}
  }
}
