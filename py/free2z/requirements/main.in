# The OIDC provider. 3.4.1, not an older 3.x, because it is the first
# release whose RFC 9700 gates cover what the sdk-v1 contract requires:
# refresh-token families with reuse detection (REFRESH_TOKEN_REUSE_PROTECTION,
# `token_family`, set-based `revoke_family`), the RFC 9207 `iss` authorization
# response parameter, refusal of the `plain` PKCE method, exact redirect-URI
# matching with the RFC 8252 loopback-port exemption, and a fixed revocation
# scoped to the requesting client. Every model is swapped into dj.apps.oidc.
# jwcrypto is its JWT/JWK dependency; pinned so the deployed image cannot
# float to a different signer than the one CI tested.
django-oauth-toolkit==3.4.1
jwcrypto==1.6.1
