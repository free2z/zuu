/.tauri/
# Generated by `tauri_plugin::Builder`'s `android_path`/`ios_path` (#937): the
# Tauri Android API is copied in at build time and the Swift package resolves
# its own dependencies. Same list as `tauri-plugin-zcash/.gitignore`, for the
# same reason — committing generated scaffolding would make every Tauri bump a
# reviewable diff of somebody else's code.
/android/.tauri/
/android/build/
/ios/.build/
/ios/Package.resolved
