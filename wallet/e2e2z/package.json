{
  "name": "e2e2z",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "e2e2z messaging surface — device keys and the f2zmsg engine. Never holds the Zcash seed and never renders remote content (see #904).",
  "scripts": {
    "dev": "vite --port 1427 --strictPort --host 127.0.0.1",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "typecheck:tests": "tsc --noEmit",
    "test": "vitest run && node --test scripts/ui-copy-truncation.node-test.mjs && playwright test",
    "tauri": "tauri",
    "test:e2e": "playwright test",
    "test:ui-copy": "node --test scripts/ui-copy-truncation.node-test.mjs",
    "verify": "npm run typecheck && npm run typecheck:tests && npm test"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "i18next": "^26.4.0",
    "i18next-icu": "^2.4.4",
    "intl-messageformat": "^11.2.14",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.12",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "jsdom": "^26.1.0",
    "linkedom": "0.18.13",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "3.2.7"
  }
}
