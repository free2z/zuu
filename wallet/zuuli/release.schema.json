{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://free2z.com/schemas/zuuli-release-v2.json",
  "title": "ZUULI release identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "applicationId",
    "iosUsesNonExemptEncryption",
    "channel",
    "version",
    "build",
    "minimums"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "applicationId": { "const": "cash.free2z.zuuli" },
    "iosUsesNonExemptEncryption": { "const": false },
    "channel": { "enum": ["internal", "beta", "stable"] },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "build": { "type": "integer", "minimum": 1, "maximum": 2100000000 },
    "minimums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ios", "android"],
      "properties": {
        "ios": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "android": { "type": "integer", "minimum": 29 }
      }
    }
  }
}
