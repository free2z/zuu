{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Mobile capability for the main ZUULI webview",
  "platforms": ["iOS", "android"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "zcash:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://free2z.cash/*" },
        { "url": "https://stage.free2z.cash/*" }
      ]
    }
  ]
}
