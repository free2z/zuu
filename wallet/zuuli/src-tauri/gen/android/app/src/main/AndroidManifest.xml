<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ZUULI holds the master seed, so this file declares the smallest set
         that still lets it reach a lightwalletd server: INTERNET, and nothing
         else (#945). CAMERA, RECORD_AUDIO and MODIFY_AUDIO_SETTINGS were here
         for the livestreaming surface that #904 phase 4 (#943) deleted along
         with the RealtimeKit dependency; an OS grant the app cannot use is
         free attack surface on the seed-holding process (#367) and a
         store-review question with no answer. The camera and microphone
         <uses-feature> overrides went with them: Play's implied-feature
         filtering is derived from the capture permissions, so with those gone
         there is nothing left to override.

         This file is not the shipped set. Manifest merge adds three more,
         and all three are reviewed and allowlisted against the *merged*
         manifest in .github/workflows/zuuli-{packaging,release}.yml:

           USE_BIOMETRIC    tauri-plugin-zcash's own manifest. ZcashPlugin.kt
                            authenticates a BiometricPrompt.CryptoObject over
                            the seed cipher, so this unlocks the wallet.
           USE_FINGERPRINT  androidx.biometric:1.1.0's manifest, for its
                            pre-API-28 FingerprintManager path. minSdk is 29,
                            so it is unreachable; it is allowlisted rather
                            than removed because it sits on the unlock path
                            and removal needs a device check (#958).
           cash.free2z.zuuli.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION
                            injected by androidx.core when targeting API 33+
                            so dynamically registered BroadcastReceivers are
                            not exported. It is this app's own permission
                            (note the package prefix) and is declared
                            signature-level; CI checks both rather than
                            assuming them.

         android.permission.DUMP also appears in the merged manifest, as the
         android:permission guard on androidx.profileinstaller's
         ProfileInstallReceiver. That restricts the receiver to shell; it is
         not a grant, and the CI assertion requires it to stay a guard. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android implies a required touchscreen. Override it so Google Play
         keeps non-touch ChromeOS devices. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.zuuli"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
            <intent-filter >
                <action android:name="android.intent.action.VIEW" />
                <!-- ChromeOS ARC++ uses a different action for deep links -->
                <action android:name="org.chromium.arc.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cash.free2z.zuuli" />
                <data android:host="oauth" />
                <data android:path="/callback" />



            </intent-filter>
            <intent-filter >
                <action android:name="android.intent.action.VIEW" />
                <!-- ChromeOS ARC++ uses a different action for deep links -->
                <action android:name="org.chromium.arc.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cash.free2z.zuuli" />
                <data android:host="checkout" />
                <data android:path="/return" />



            </intent-filter>
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
